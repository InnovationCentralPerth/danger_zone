# Meraki
MERAKI_API_KEY=your_meraki_api_key_here
MERAKI_ORG_ID=your_org_id_here
MERAKI_WEBHOOK_SECRET=your_webhook_shared_secret_here
# Set to true ONLY for dev with a write-scoped key — prefer creating a
# read-only Meraki admin in Dashboard > Organization > Administrators.
MERAKI_ALLOW_WRITE_KEY=false

# GitHub Models (OpenAI-compatible endpoint)
GITHUB_TOKEN=your_github_pat_here
MODEL_ID=openai/gpt-4o-mini

# Self-hosted VLM (vLLM / SGLang, OpenAI-compatible). Leave VLM_BASE_URL empty
# to use GitHub Models above. When set, VLM_API_KEY must match the server's
# --api-key (any non-empty value if the server has no auth).
# VLM_BASE_URL=http://127.0.0.1:8000/v1
# VLM_API_KEY=your_vllm_api_key_here

# Video ingest (file / rtsp / synthetic sources declared in config/cameras.yaml)
INGEST_ENABLED=false

# App
API_KEY=changeme_for_external_agent_auth
SECRET_KEY=changeme_long_random_string
DEBUG=false
# Enable the synthetic demo agent (fires fake incidents every 15s).
# Useful for UI work; leave off when testing real cameras.
DEMO_AGENT=false

# Storage
DATA_DIR=data
SNAPSHOT_MAX_AGE_DAYS=30
